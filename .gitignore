# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.ipr
*.iws

# Keystore files
*.jks
*.keystore
keystore.properties

# External native build folder
.cxx/

# Google Services (don't use - we are Google-free)
google-services.json

# OS
.DS_Store
Thumbs.db

# Models (large files) — anchor to repo root so it doesn't swallow the
# `feature/models/` source package.
*.task
*.bin
*.tflite
/models/

# iOS（ios/Yiren.xcodeproj 由 xcodegen 再生，不入库）
/ios/Yiren.xcodeproj/
/ios/build/
/ios/*.xcworkspace
/ios/BundledModels/*
!/ios/BundledModels/.gitkeep
appstore-screenshots/
.codeflicker/
