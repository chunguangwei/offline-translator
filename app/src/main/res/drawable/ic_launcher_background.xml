<?xml version="1.0" encoding="utf-8"?>
<!--
    译人 (Yiren) adaptive icon background — 暖色品牌渐变。
    主渐变: #FFB152 → #FF6F61 → #C2479B (橙 → 珊瑚红 → 洋红, 135°)，
    叠左上高光产生玻璃质感。与前景白色气泡头人形对比鲜明。
    Adaptive icon viewport 108×108。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 主品牌渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFB152"
                android:centerColor="#FF6F61"
                android:endColor="#C2479B" />
        </shape>
    </item>

    <!-- 左上高光（玻璃质感） -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="64"
                android:centerX="0.30"
                android:centerY="0.20"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>

</layer-list>
